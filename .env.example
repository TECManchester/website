# =============================================================================
# Elevation Church Manchester — environment
#
# Copy to .env.local and fill in. .env.local is gitignored; NEVER commit real
# values. Only NEXT_PUBLIC_* vars reach the browser — everything else is
# server-only and must stay that way.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — project "imsmgftkwjbwaaqqzwta"
# Dashboard: https://supabase.com/dashboard/project/imsmgftkwjbwaaqqzwta
# -----------------------------------------------------------------------------

# PUBLIC. Safe in the browser. Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL="https://imsmgftkwjbwaaqqzwta.supabase.co"

# PUBLIC. Safe in the browser — Row Level Security is what protects your data,
# not this key. Settings -> API Keys -> "publishable" (new) or "anon" (legacy).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# SECRET. Server-only. Bypasses ALL Row Level Security — treat like a root
# password. Settings -> API Keys -> "secret" (new) or "service_role" (legacy).
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""

# SECRET. Personal Access Token for the Supabase CLI (migrations, type gen).
# Create at https://supabase.com/dashboard/account/tokens while signed in to the
# account that OWNS this project.
#
# Setting it here scopes CLI auth to this project only — it overrides the global
# `supabase login`, so your other Supabase account is unaffected.
SUPABASE_ACCESS_TOKEN=""

# SECRET. Database password, for `supabase db push` and direct connections.
# Settings -> Database -> Database password (reset it if unknown).
SUPABASE_DB_PASSWORD=""

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Canonical origin — drives metadata, sitemap.xml, robots.txt and OG tags.
# CONFIRM whether this build replaces elevationmanchester.org.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Transactional email — contact form, prayer requests, newsletter confirmations
# https://resend.com/api-keys
# -----------------------------------------------------------------------------

RESEND_API_KEY=""

# Verified sender domain in Resend, e.g. "Elevation Church Manchester <hello@elevationmanchester.org>"
EMAIL_FROM=""

# Where contact + prayer submissions are delivered.
# CONFIRM the Manchester inbox.
EMAIL_TO=""

# Prayer requests are sensitive and pastoral. If a separate, tighter-access
# inbox exists, set it here; otherwise it falls back to EMAIL_TO.
PRAYER_INBOX=""
